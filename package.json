{
  "name": "tab-sketch",
  "version": "1.0.0",
  "description": "Simple HTML/CSS guitar chord diagram renderer",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/components/index.js",
    "./chords": "./dist/chords.js",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build-dev": "node scripts/build.mjs && npm pack --ignore-scripts",
    "build-prod": "node scripts/build.mjs --minify && npm pack --ignore-scripts",
    "prepack": "node scripts/build.mjs --minify",
    "pack": "npm pack",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "guitar",
    "chord",
    "tab",
    "diagram",
    "fretboard",
    "html"
  ],
  "license": "MIT",
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/html": "8.6.18",
    "@storybook/html-vite": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@vitejs/plugin-react": "4.3.0",
    "esbuild": "0.25.12",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "storybook": "8.6.18"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}